{
  "schemaVersion": 1,
  "id": "io.github.dealenx.happ-vpn",
  "name": "Happ",
  "version": "1.0.0",
  "author": "dealenx",
  "license": "MIT",
  "description": "Happ VPN in the Omarchy bar: an H mark that lights up while the tunnel is up, with Happ's own tray menu one click away.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Happ",
    "description": "Happ tunnel state; left click opens Happ's menu, right click starts or raises it.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 2
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 2
      }
    ]
  }
}
